#!/bin/sh

set -eu

root="$HOME/git"
printf 'Task name: ' >&2
IFS= read -r task_name || exit 0
[ -n "$task_name" ] || exit 0

selected=$(
	for repo in "$root"/*; do
		[ -d "$repo" ] && basename "$repo"
	done |
		fzf --multi --reverse --prompt='Repositories> ' \
			--header='Tab to select repositories, Enter to create task workspace'
) || exit 0

[ -n "$selected" ] || exit 0

herdr workspace create --cwd "$root" --label "$task_name" --focus >/dev/null
workspace_id=$(
	herdr workspace list |
		jq -r --arg label "$task_name" '.result.workspaces[] | select(.focused == true and .label == $label) | .workspace_id' |
		head -n 1
)
[ -n "$workspace_id" ] || exit 1

initial_tab=$(
	herdr tab list --workspace "$workspace_id" |
		jq -r '.result.tabs[0].tab_id'
)
herdr tab rename "$initial_tab" pi

pi_pane=$(
	herdr pane list --workspace "$workspace_id" |
		jq -r --arg tab "$initial_tab" '.result.panes[] | select(.tab_id == $tab) | .pane_id' |
		head -n 1
)
herdr pane run "$pi_pane" pi

printf '%s\n' "$selected" | while IFS= read -r repo_name; do
	[ -n "$repo_name" ] || continue
	repo="$root/$repo_name"

	herdr tab create --workspace "$workspace_id" --cwd "$repo" --label "$repo_name" --no-focus >/dev/null
	repo_tab=$(
		herdr tab list --workspace "$workspace_id" |
			jq -r --arg label "$repo_name" '.result.tabs[] | select(.label == $label) | .tab_id' |
			head -n 1
	)
	nvim_pane=$(
		herdr pane list --workspace "$workspace_id" |
			jq -r --arg tab "$repo_tab" '.result.panes[] | select(.tab_id == $tab) | .pane_id' |
			head -n 1
	)

	herdr pane run "$nvim_pane" nvim
	herdr pane split "$nvim_pane" --direction down --ratio 0.7 --cwd "$repo" --no-focus >/dev/null
done

herdr tab focus "$initial_tab"
