#!/bin/sh

set -eu

[ -r "$HOME/.local/sh/dirs.env" ] && . "$HOME/.local/sh/dirs.env"
host_name=$(hostname -s)
host_dirs="$HOME/.local/sh/dirs-$host_name.env"
[ -r "$host_dirs" ] && . "$host_dirs"
: "${REPO_GALLERY_DIR:=$HOME/git}"
root="$REPO_GALLERY_DIR"

list_repos() {
	for repo in "$root"/*; do
		[ -d "$repo" ] && basename "$repo"
	done
}

mode=$(
	printf '%s\n' single-repo multi-repo |
		fzf --reverse --prompt='Workflow> ' \
			--header='Choose a single-repo or multi-repo task'
) || exit 0

case "$mode" in
single-repo)
	selected=$(list_repos | fzf --reverse --prompt='Repository> ') || exit 0
	[ -n "$selected" ] || exit 0
	task_name=$selected
	workspace_cwd="$root/$selected"
	;;
multi-repo)
	printf 'Task name: ' >&2
	IFS= read -r task_name || exit 0
	[ -n "$task_name" ] || exit 0

	selected=$(
		list_repos |
			fzf --multi --reverse --prompt='Repositories> ' \
				--header='Tab to select repositories, Enter to create task workspace'
	) || exit 0
	[ -n "$selected" ] || exit 0
	workspace_cwd="$root"
	;;
*)
	exit 0
	;;
esac

herdr workspace create --cwd "$workspace_cwd" --label "$task_name" --focus >/dev/null
workspace_id=$(
	herdr workspace list |
		jq -r --arg label "$task_name" '.result.workspaces[] | select(.focused == true and .label == $label) | .workspace_id' |
		head -n 1
)
[ -n "$workspace_id" ] || exit 1

initial_tab=$(
	herdr tab list --workspace "$workspace_id" |
		jq -r '.result.tabs[0].tab_id'
)
herdr tab rename "$initial_tab" pi

pi_pane=$(
	herdr pane list --workspace "$workspace_id" |
		jq -r --arg tab "$initial_tab" '.result.panes[] | select(.tab_id == $tab) | .pane_id' |
		head -n 1
)
herdr pane run "$pi_pane" pi

printf '%s\n' "$selected" | while IFS= read -r repo_name; do
	[ -n "$repo_name" ] || continue
	repo="$root/$repo_name"

	herdr tab create --workspace "$workspace_id" --cwd "$repo" --label "$repo_name" --no-focus >/dev/null
	repo_tab=$(
		herdr tab list --workspace "$workspace_id" |
			jq -r --arg label "$repo_name" '.result.tabs[] | select(.label == $label) | .tab_id' |
			head -n 1
	)
	nvim_pane=$(
		herdr pane list --workspace "$workspace_id" |
			jq -r --arg tab "$repo_tab" '.result.panes[] | select(.tab_id == $tab) | .pane_id' |
			head -n 1
	)

	herdr pane run "$nvim_pane" nvim
	herdr pane split "$nvim_pane" --direction down --ratio 0.7 --cwd "$repo" --no-focus >/dev/null
done

herdr tab list --workspace "$workspace_id" |
	jq -r '.result.tabs[] | [.number, .tab_id, .label] | @tsv' |
	while IFS="$(printf '\t')" read -r number tab_id label; do
		herdr tab rename "$tab_id" "$number: $label"
	done

herdr tab focus "$initial_tab"
