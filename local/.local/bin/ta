#!/bin/bash
#
# Attach or create tmux session named after the target directory.
#
# Usage:
#   ta                         attach to existing session (if not in tmux)
#   ta --start                 generic session in current directory
#   ta [--mode MODE] <dir>     pick project from gallery dir, optionally specify mode
#   ta --mode MODE <path>      direct path + mode (used by scripts like twt)
#
# Modes:
#   generic  plain shell session
#   code     window 1: nvim
#   ai       window 1: nvim, window 2: claude, window 3: shell
#
# Forked and modified from: https://github.com/WaylonWalker/devtainer/blob/main/bin/.local/bin/ta

MODE=""
DIR=""

not_in_tmux() {
  [ -z "$TMUX" ]
}

# Parse args
while [[ $# -gt 0 ]]; do
  case "$1" in
    --start)
      MODE="generic"
      shift
      ;;
    --mode)
      MODE="$2"
      shift 2
      ;;
    *)
      DIR="$1"
      shift
      ;;
  esac
done

# No dir and no mode: attach to existing session or fall back to generic in cwd
if [ -z "$DIR" ] && [ -z "$MODE" ]; then
  if not_in_tmux; then
    tmux attach -d && exit 0
    # attach failed (no sessions) — start generic in cwd
    MODE="generic"
  else
    exit 1
  fi
fi

# Mode set but no dir: use cwd
if [ -z "$DIR" ]; then
  DIR="$PWD"
fi

# Determine if DIR is a direct project path or a gallery to pick from
is_project_dir() {
  [ -e "$1/.git" ]
}

if is_project_dir "$DIR"; then
  path_name="$DIR"
else
  # Gallery: fzf pick project
  _session_name=$(cd "$DIR" && ls -d */ | sed "s|/||g" | fzf --reverse --header="Select project from $(basename "$DIR") >")
  [ -z "$_session_name" ] && exit 1
  path_name="$DIR/$_session_name"
fi

# Resolve symlinks
if [ -L "$path_name" ]; then
  path_name=$(realpath "$path_name")
fi

# Prompt for mode if not set
if [ -z "$MODE" ]; then
  MODE=$(printf 'ai\ncode\ngeneric' | fzf --reverse --header="Select session mode >")
  [ -z "$MODE" ] && exit 1
fi

session_name=$(basename "$path_name" | tr './' '--')

session_exists() {
  tmux has-session -t "=$session_name" 2>/dev/null
}

create_detached_session() {
  TMUX='' tmux new-session -Ad -s "$session_name" -c "$path_name" -n "nvim"

  case "$MODE" in
    generic)
      tmux rename-window -t "$session_name:nvim" "shell"
      ;;
    code)
      tmux send-keys -t "$session_name:nvim" "nvim" Enter
      ;;
    ai)
      tmux send-keys -t "$session_name:nvim" "nvim" Enter
      tmux new-window -t "$session_name" -c "$path_name" -n "claude"
      tmux send-keys -t "$session_name:claude" "claude" Enter
      tmux new-window -t "$session_name" -c "$path_name" -n "shell"
      tmux select-window -t "$session_name:nvim"
      ;;
  esac
}

if ! session_exists; then
  create_detached_session
fi

if not_in_tmux; then
  tmux attach -d -t "$session_name"
else
  tmux switch-client -t "$session_name"
fi
