#!/bin/sh

set -eu

workspace_id=$1
source="herdr-task-git:$workspace_id"

while herdr workspace get "$workspace_id" >/dev/null 2>&1; do
	index=1
	while IFS= read -r repo; do
		[ -n "$repo" ] || continue
		top=$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null) || continue

		repo_name=$(basename "$top")
		dirty=$(git -C "$repo" status --porcelain 2>/dev/null)
		counts=$(git -C "$repo" rev-list --left-right --count HEAD...@{upstream} 2>/dev/null || true)
		ahead=$(printf '%s\n' "$counts" | awk '{print $1 + 0}')
		behind=$(printf '%s\n' "$counts" | awk '{print $2 + 0}')

		if [ -n "$dirty" ]; then
			status="● $repo_name"
		else
			status="✓ $repo_name"
		fi
		sync=""
		[ "$ahead" -gt 0 ] && sync="$sync ↑$ahead"
		[ "$behind" -gt 0 ] && sync="$sync ↓$behind"
		status_key=$(printf 'repo_%02d_status' "$index")
		sync_key=$(printf 'repo_%02d_sync' "$index")

		if [ -n "$sync" ]; then
			herdr workspace report-metadata "$workspace_id" \
				--source "$source" \
				--token "$status_key=$status" \
				--token "$sync_key=$sync" \
				--ttl-ms 15000 >/dev/null
		else
			herdr workspace report-metadata "$workspace_id" \
				--source "$source" \
				--clear-token "$sync_key" \
				--token "$status_key=$status" \
				--ttl-ms 15000 >/dev/null
		fi
		index=$((index + 1))
		[ "$index" -le 14 ] || break
	done <<EOF
$(herdr pane list --workspace "$workspace_id" | jq -r '.result.panes[].cwd' | sort -u)
EOF

	sleep 5
done
