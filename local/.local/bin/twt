#!/bin/bash
#
# twt - tmux worktree manager
#
# Usage:
#   twt [ticket]    create a new worktree (must be in the main repo)
#   twt --pick      pick repo + ticket interactively from any tmux session
#   twt --remove    interactively remove a worktree and clean up galleries
#
# Worktrees are stored in ~/worktrees/<repo>-<branch>.
# Gallery symlinks are tracked per-worktree in .twt-galleries so they
# survive update_link_galleries rebuilds.

set -e

WORKTREES_DIR="$HOME/worktrees"

# Prefer a standalone gibr binary; fall back to uvx
if command -v gibr &>/dev/null; then
  GIBR="gibr"
elif command -v uvx &>/dev/null; then
  GIBR="uvx gibr"
else
  echo "Error: gibr not found (install gibr or uv)" >&2
  exit 1
fi

# ── helpers ───────────────────────────────────────────────────────────────────

# Sets globals: repo_root, repo_name, main_worktree
# Exits if not in a git repo or not in the main worktree.
_assert_main_worktree() {
  if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    echo "Error: not in a git repository" >&2
    exit 1
  fi
  repo_root=$(git rev-parse --show-toplevel)
  repo_name=$(basename "$repo_root")
  main_worktree=$(git worktree list --porcelain | awk '/^worktree /{print $2; exit}')
  if [[ "$main_worktree" != "$repo_root" ]]; then
    echo "Error: must be run from the main worktree" >&2
    echo "  main:    $main_worktree" >&2
    echo "  current: $repo_root" >&2
    exit 1
  fi
}

_detect_galleries() {
  local repo_abs
  repo_abs=$(cd "$repo_root" && pwd -P)
  for gallery in ~/git ~/work; do
    [[ -d "$gallery" ]] || continue
    while IFS= read -r link; do
      local target
      target=$(realpath "$link" 2>/dev/null) || continue
      [[ "$target" == "$repo_abs" ]] && echo "$gallery" && break
    done < <(find "$gallery" -maxdepth 1 -type l)
  done
}

# Core create logic; expects repo_root/repo_name set by _assert_main_worktree
_create() {
  local ticket="$1"
  local current_branch
  current_branch=$(git branch --show-current)

  if [[ -z "$ticket" ]]; then
    printf "Ticket number: "
    read -r ticket
    [[ -z "$ticket" ]] && exit 1
  fi

  $GIBR create "$ticket"

  local new_branch
  new_branch=$(git branch --show-current)

  if [[ "$new_branch" == "$current_branch" ]]; then
    echo "Error: no branch change detected — did gibr succeed?" >&2
    exit 1
  fi

  # Move new branch to worktree; return main checkout to original branch
  git checkout "$current_branch"

  local safe_branch="${new_branch//\//-}"
  local wt_name="${repo_name}-${safe_branch}"
  local wt_path="$WORKTREES_DIR/$wt_name"

  mkdir -p "$WORKTREES_DIR"
  git worktree add "$wt_path" "$new_branch"

  local galleries
  galleries=$(_detect_galleries)

  if [[ -n "$galleries" ]]; then
    echo "$galleries" > "$wt_path/.twt-galleries"
    while IFS= read -r gallery; do
      ln -sf "$wt_path" "$gallery/$wt_name"
      echo "Linked: $gallery/$wt_name"
    done <<< "$galleries"
  fi

  echo "Worktree created: $wt_path"
  ta --mode ai "$wt_path"
}

# ── commands ──────────────────────────────────────────────────────────────────

do_create() {
  _assert_main_worktree
  _create "${1:-}"
}

do_pick() {
  # Build repo list from ~/git, excluding worktree entries, show basenames
  local selected
  selected=$(
    find ~/git -maxdepth 1 -type l 2>/dev/null | sort | while IFS= read -r link; do
      local target
      target=$(realpath "$link" 2>/dev/null) || continue
      [[ "$target" == "$WORKTREES_DIR/"* ]] && continue
      printf '%s\t%s\n' "$(basename "$link")" "$target"
    done | fzf --reverse --header="Select repo >" --with-nth=1 --delimiter=$'\t'
  )
  [[ -z "$selected" ]] && exit 1

  local path_name
  path_name=$(printf '%s' "$selected" | cut -f2)

  cd "$path_name" || exit 1
  _assert_main_worktree
  _create "$ticket"
}

do_remove() {
  if [[ ! -d "$WORKTREES_DIR" ]] || [[ -z "$(ls -A "$WORKTREES_DIR" 2>/dev/null)" ]]; then
    echo "No worktrees found in $WORKTREES_DIR"
    exit 0
  fi

  local selected
  selected=$(ls "$WORKTREES_DIR" | fzf --reverse --header="Select worktree to remove >")
  [[ -z "$selected" ]] && exit 1

  local wt_path="$WORKTREES_DIR/$selected"
  local session_name
  session_name=$(echo "$selected" | tr './' '--')

  if tmux has-session -t "=$session_name" 2>/dev/null; then
    echo "Warning: tmux session '$session_name' is still active"
    printf "Continue? [y/N] "
    read -r confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || exit 1
  fi

  if [[ -f "$wt_path/.twt-galleries" ]]; then
    while IFS= read -r gallery; do
      local link="$gallery/$selected"
      if [[ -L "$link" ]]; then
        rm "$link"
        echo "Removed symlink: $link"
      fi
    done < "$wt_path/.twt-galleries"
  fi

  # Find main worktree via git, then remove from there
  local main_wt
  main_wt=$(git -C "$wt_path" worktree list --porcelain | awk '/^worktree /{print $2; exit}')

  if ! git -C "$main_wt" worktree remove "$wt_path" 2>/dev/null; then
    echo "Worktree has uncommitted changes."
    printf "Force remove? [y/N] "
    read -r confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || exit 1
    git -C "$main_wt" worktree remove "$wt_path" --force
  fi

  echo "Removed worktree: $selected"
}

# ── main ──────────────────────────────────────────────────────────────────────

case "${1:-}" in
  --pick)   do_pick ;;
  --remove) do_remove ;;
  *)        do_create "${1:-}" ;;
esac
