# Shared directory contract. Keep this file POSIX-shell compatible so Bash
# scripts and zsh can source it.

: "${REPO_ROOT:=$HOME/github.com}"
: "${REPO_GALLERY_DIR:=$HOME/git}"
: "${WORK_GALLERY_DIR:=$HOME/work}"
: "${WORKTREES_DIR:=$HOME/worktrees}"

: "${PI_AGENT_DIR:=$HOME/.pi/agent}"
: "${PI_BIN_DIR:=$PI_AGENT_DIR/bin}"
: "${ZOEKT_INDEX_DIR:=$HOME/.zoekt}"

export REPO_ROOT REPO_GALLERY_DIR WORK_GALLERY_DIR WORKTREES_DIR
export PI_AGENT_DIR PI_BIN_DIR ZOEKT_INDEX_DIR
