{{- /*
  One secret, looked up in whichever backend this machine uses (.secrets).
  Usage: {{ template "secret" (list .secrets "pass://SHARE/ITEM/FIELD" "op://VAULT/ITEM/FIELD") }}
  Either reference may be "" if the secret doesn't exist on that backend.
*/ -}}
{{- $backend := index . 0 -}}
{{- $pass := index . 1 -}}
{{- $op := index . 2 -}}
{{- if and (eq $backend "protonpass") $pass -}}
{{- protonPass $pass | trim -}}
{{- else if and (eq $backend "1password") $op -}}
{{- onepasswordRead $op | trim -}}
{{- end -}}
