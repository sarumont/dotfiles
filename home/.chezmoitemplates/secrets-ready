{{- /*
  "true" if this machine's secrets backend (passed in: .secrets) has a usable
  session, else "false". Never fails, so callers can skip secret-backed files.
  Usage: {{ includeTemplate "secrets-ready" .secrets }}
*/ -}}
{{- if eq . "protonpass" -}}
{{-   output "sh" "-c" "pass-cli vault list >/dev/null 2>&1 && echo true || echo false" | trim -}}
{{- else if eq . "1password" -}}
{{-   output "sh" "-c" "op whoami >/dev/null 2>&1 && echo true || echo false" | trim -}}
{{- else -}}
false
{{- end -}}
