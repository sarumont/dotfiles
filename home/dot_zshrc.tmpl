#zmodload zsh/zprof

# Path to oh-my-zsh installation
{{- if eq .chezmoi.os "linux" }}
# (yay -S oh-my-zsh-git)
export ZSH=/usr/share/oh-my-zsh
{{- else }}
# (chezmoi external, see .chezmoiexternal.toml.tmpl)
export ZSH=$HOME/.oh-my-zsh
{{- end }}

# OMZ config
DISABLE_AUTO_UPDATE="true"
COMPLETION_WAITING_DOTS="true"
HIST_STAMPS="yyyy-mm-dd"
HISTSIZE=50000
SAVEHIST=50000

# tweak compinit/compaudit; keep the cache out of $ZSH (read-only on Linux)
ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-zsh"
ZSH_DISABLE_COMPFIX="true"
ZSH_COMPDUMP="${ZSH_CACHE_DIR}/.zcompdump-${SHORT_HOST}-${ZSH_VERSION}"
mkdir -p "$ZSH_CACHE_DIR"

# set TMUX session name
if [[ -n "$TMUX" ]]; then
  export TMUX_SESSION_NAME=$(tmux display-message -p '#S')
fi

{{ if eq .chezmoi.os "darwin" -}}
COPY=pbcopy
{{- else -}}
COPY=wl-copy
{{- end }}

plugins=(
{{- if eq .chezmoi.os "darwin" }}
  macos
{{- else }}
  archlinux
{{- end }}
  git
  gitfast
  httpie
  kubectl
  sudo
)

typeset -U fpath
fpath+=(
  "$HOME/.zfunctions"
)

source $ZSH/oh-my-zsh.sh

# set custom options
setopt histreduceblanks hist_ignore_dups hist_ignore_space share_history extendedglob notify dvorak CHASE_LINKS

# vim mode
bindkey -v

# copy current command to clipboard
copy-command() {
  echo -n $BUFFER | $COPY
  zle -M "copied to clipboard"
}
zle -N copy-command
bindkey '^Xc' copy-command

if [[ -r ~/.local/sh/zshrc ]]; then
  . ~/.local/sh/zshrc
fi

# Editor setup
if command -v nvim &> /dev/null; then
  export EDITOR=nvim
elif command -v vim &> /dev/null; then
  export EDITOR=vim
fi
alias vim=$EDITOR
alias vi=$EDITOR

export PG_PAGER="$EDITOR -R -c 'set ft=dbout' -"

# Source aliases and functions
. ~/.aliases.zsh
. ~/.functions.zsh
{{- if .omarchy }}

# Omarchy helpers ported from /usr/share/omarchy/default/bash
alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
alias eff='$EDITOR "$(ff)"'
alias mup='MISE_MINIMUM_RELEASE_AGE=0 mise up'
open() (
  xdg-open "$@" >/dev/null 2>&1 &
)
# herdr layouts (hdl, hds, hdlm, hsl) are bash; sticky ksh emulation runs them as written
if [[ -r $OMARCHY_PATH/default/bash/fns/herdr ]]; then
  emulate ksh -c ". $OMARCHY_PATH/default/bash/fns/herdr"
fi
{{- end }}

# Starship
_starship_cache="${XDG_CACHE_HOME:-$HOME/.cache}/starship-init.zsh"
if [[ ! -f "$_starship_cache" ]] || [[ $(command -v starship) -nt "$_starship_cache" ]]; then
  starship init zsh > "$_starship_cache"
fi
source "$_starship_cache"

# zoxide
_zoxide_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zoxide-init.zsh"
if [[ ! -f "$_zoxide_cache" ]] || [[ $(command -v zoxide) -nt "$_zoxide_cache" ]]; then
  zoxide init --cmd cd zsh > "$_zoxide_cache"
fi
source "$_zoxide_cache"

# direnv
if command -v direnv &> /dev/null; then
  _direnv_hook_cache="${XDG_CACHE_HOME:-$HOME/.cache}/direnv-hook.zsh"
  if [[ ! -f "$_direnv_hook_cache" ]] || [[ $(command -v direnv) -nt "$_direnv_hook_cache" ]]; then
    direnv hook zsh > "$_direnv_hook_cache"
  fi
  source "$_direnv_hook_cache"

fi

# fzf
if [[ -z "$FZF_BASE" && -d "/usr/share/fzf" ]]; then
  export FZF_BASE="/usr/share/fzf"
fi
if [[ -n "$FZF_BASE" ]]; then
  source "$FZF_BASE/completion.zsh" 2> /dev/null
  source "$FZF_BASE/key-bindings.zsh" 2> /dev/null
fi

# Lazy-loading
docker() {
  unfunction docker
  source $ZSH/plugins/docker/docker.plugin.zsh
  docker "$@"
}

eval "$(mise activate zsh)"

zprof_on_prompt() {
  zprof
  unset -f zprof_on_prompt
  precmd_functions=("${(@)precmd_functions:#zprof_on_prompt}")
}
#precmd_functions+=(zprof_on_prompt)

# Keep Herdr tab indices and Git status synchronized globally.
if command -v herdr-workspace-git-status &> /dev/null; then
  herdr-workspace-git-status >/dev/null 2>&1 &!
fi

# zsh-syntax-highlighting must be sourced last
for f in \
{{- if eq .chezmoi.os "darwin" }}
  /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
{{- else }}
  /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
{{- end }}
do
  if [[ -r $f ]]; then
    source $f
    break
  fi
done
