{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "sarumont.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators",
          "items": [
            "Dictation",
            "ScreenRecording",
            "Reminder",
            "Dnd",
            "StayAwake"
          ]
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.elsewhen",
          "cities": [
            {
              "name": "Hawaii",
              "zone": "Pacific/Honolulu"
            },
            {
              "name": "London",
              "zone": "Europe/London"
            },
            {
              "name": "Bucharest",
              "zone": "Europe/Bucharest"
            }
          ]
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ]
    }
  },
  "plugins": []
}
