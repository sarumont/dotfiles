typeset -U path

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export RIPGREP_CONFIG_PATH=$HOME/.config/ripgrep/config
export OBSIDIAN_VAULT_DIR=$HOME/notes
{{- if .omarchy }}

# Omarchy's interactive env from /usr/share/omarchy/default/bash/envs, which
# only bash sources. (OMARCHY_PATH, PATH and TERMINAL come from the uwsm
# session; EDITOR is set in .zshrc.)
export BROWSER="${BROWSER:-omarchy-launch-browser}"
export BAT_THEME=ansi
export MANROFFOPT="-c"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"
{{- end }}

# path prepend
path[1,0]=(
    $HOME/.local/bin
{{- if eq .chezmoi.os "darwin" }}
    /opt/local/bin
    /opt/local/sbin
{{- end }}
)

# source shared directory definitions
if [[ -r ~/.local/sh/dirs.env ]]; then
    . ~/.local/sh/dirs.env
fi
for f in ~/.local/sh/dirs-*.env(N); do
    . "$f"
done

# source machine-specific code: <host>.zshenv is managed, zshenv is local-only
for f in ~/.local/sh/*.zshenv(N); do
    . $f
done

if [[ -r ~/.local/sh/zshenv ]]; then
    . ~/.local/sh/zshenv
fi

# path append
path+=(
    $PI_BIN_DIR
    $HOME/go/bin
{{- if eq .chezmoi.os "darwin" }}
    /opt/homebrew/bin
{{- end }}
)
path=($^path(N))
