{{- /* Per-machine config. Rendered once by `chezmoi init`; answers are cached in ~/.config/chezmoi/chezmoi.toml. */ -}}
{{- $omarchy := false -}}
{{- if stat "/usr/share/omarchy" -}}
{{-   $omarchy = true -}}
{{- end -}}
{{- $personal := promptBoolOnce . "personal" "Personal machine" -}}
{{- $email := promptStringOnce . "email" "Git email" -}}
{{- $secrets := promptChoiceOnce . "secrets" "Secrets backend" (list "protonpass" "1password" "none") -}}
sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
  omarchy  = {{ $omarchy }}
  personal = {{ $personal }}
  email    = {{ $email | quote }}
  # protonpass (pass-cli) | 1password (op) | none; picks the lookup in secret templates
  secrets  = {{ $secrets | quote }}
