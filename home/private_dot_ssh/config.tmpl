# Private host entries, rendered from the secrets backend (see README "Secrets")
Include ~/.ssh/config.d/*

# Defaults for every host. ssh uses the first value it finds for each option,
# so these come last and per-host settings above win.
Host *
  Compression yes
  # keep idle sessions alive through NAT/Wi-Fi changes; drop dead ones in ~3 min
  ServerAliveInterval 60
  ServerAliveCountMax 3
  # trust new hosts automatically, still refuse changed host keys
  StrictHostKeyChecking accept-new
{{- if eq .chezmoi.os "darwin" }}
  # passphrase-protected key: store the passphrase in the macOS Keychain and
  # add the key to the system agent on first use
  UseKeychain yes
  AddKeysToAgent yes
{{- end }}
