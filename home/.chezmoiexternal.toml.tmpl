{{- if eq .chezmoi.os "darwin" }}
# No oh-my-zsh package on macOS (Linux uses: yay -S oh-my-zsh-git)
[".oh-my-zsh"]
    type = "archive"
    url = "https://github.com/ohmyzsh/ohmyzsh/archive/master.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"
{{- end }}


# tmux plugin manager; plugins are installed by run_onchange_after_tmux-plugins.sh
[".config/tmux/plugins/tpm"]
    type = "git-repo"
    url = "https://github.com/tmux-plugins/tpm.git"
    refreshPeriod = "168h"
