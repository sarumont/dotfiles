#!/bin/sh

set -eu

selected=$(
	herdr workspace list |
		jq -r '.result.workspaces[] | [.workspace_id, .label, .number, .pane_count, .tab_count] | @tsv' |
		awk -F '\t' '{printf "%s\t%-28s %3s  %5s  %4s\n", $1, $2, $3, $4, $5}' |
		fzf --reverse --with-nth=2.. --delimiter='\t' \
			--header='WORKSPACE                     #  PANES  TABS' \
			--no-info --prompt='Workspace> '
) || exit 0

[ -n "$selected" ] || exit 0
workspace_id=$(printf '%s\n' "$selected" | cut -f1)
exec herdr workspace focus "$workspace_id"
