#!/bin/sh

set -eu

[ -r "$HOME/.local/sh/dirs.env" ] && . "$HOME/.local/sh/dirs.env"
host_name=$(hostname -s)
host_dirs="$HOME/.local/sh/dirs-$host_name.env"
[ -r "$host_dirs" ] && . "$host_dirs"
: "${REPO_GALLERY_DIR:=$HOME/git}"
root="$REPO_GALLERY_DIR"
selected=$(
	for repo in "$root"/*; do
		[ -d "$repo" ] && basename "$repo"
	done |
		fzf --reverse --prompt='Workspace> '
) || exit 0

[ -n "$selected" ] || exit 0
label=$selected
exec herdr workspace create --cwd "$root/$label" --label "$label" --focus
