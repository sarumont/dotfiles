#!/bin/sh

set -eu

[ -r "$HOME/.local/sh/dirs.env" ] && . "$HOME/.local/sh/dirs.env"
host_name=$(hostname -s)
host_dirs="$HOME/.local/sh/dirs-$host_name.env"
[ -r "$host_dirs" ] && . "$host_dirs"
: "${REPO_GALLERY_DIR:=$HOME/git}"
: "${HERDR_AGENT_HARNESS:=pi}"
root="$REPO_GALLERY_DIR"

list_repos() {
	for repo in "$root"/*; do
		[ -d "$repo" ] && basename "$repo"
	done
}

fail_ticket() {
	printf '%s\n' "$1" >&2
	printf 'Press Enter to close. ' >&2
	IFS= read -r _ || true
	exit 1
}

mode=$(
	printf '%s\n' single-repo multi-repo ticket generic |
		fzf --reverse --prompt='Workflow> ' \
			--header='Choose a single-repo, multi-repo, ticket, or generic task'
) || exit 0

case "$mode" in
single-repo)
	selected=$(list_repos | fzf --reverse --prompt='Repository> ') || exit 0
	[ -n "$selected" ] || exit 0
	task_name=$selected
	workspace_cwd="$root/$selected"
	;;
multi-repo)
	printf 'Task name: ' >&2
	IFS= read -r task_name || exit 0
	[ -n "$task_name" ] || exit 0

	selected=$(
		list_repos |
			fzf --multi --reverse --prompt='Repositories> ' \
				--header='Tab to select repositories, Enter to create task workspace'
	) || exit 0
	[ -n "$selected" ] || exit 0
	workspace_cwd="$root"
	;;
ticket)
	printf 'Ticket: ' >&2
	IFS= read -r ticket || exit 0
	ticket=$(printf '%s\n' "$ticket" | grep -Eo '[[:alpha:]]+-[[:digit:]]+' | head -n 1 || true)
	[ -n "$ticket" ] || fail_ticket 'Expected a ticket ID such as LEDG-4430.'

	if ! issue_json=$(linear issue view "$ticket" --json --no-comments 2>&1); then
		fail_ticket "Could not load $ticket from Linear:\n$issue_json"
	fi
	if ! labels=$(printf '%s\n' "$issue_json" | jq -er '.labels.nodes[]?.name' 2>&1); then
		fail_ticket "Could not parse the Linear response for $ticket:\n$labels"
	fi
	repos=$(list_repos)
	selected=$(
		while IFS= read -r label; do
			[ -n "$label" ] || continue
			exact=$(printf '%s\n' "$repos" | grep -Fx "$label" || true)
			if [ -n "$exact" ]; then
				printf '%s\n' "$exact"
				continue
			fi
			prefix_matches=$(printf '%s\n' "$repos" | awk -v prefix="$label" 'index($0, prefix) == 1')
			prefix_count=$(printf '%s\n' "$prefix_matches" | awk 'NF { count++ } END { print count + 0 }')
			[ "$prefix_count" -eq 1 ] && printf '%s\n' "$prefix_matches" || true
		done <<EOF
$labels
EOF
	)
	[ -n "$selected" ] || {
		printf 'No repository labels matched ticket %s\n' "$ticket" >&2
		exit 1
	}

	exec herdr-workspace-new "$ticket" "$selected"
	;;
generic)
	printf 'Workspace name: ' >&2
	IFS= read -r task_name || exit 0
	[ -n "$task_name" ] || exit 0
	workspace_cwd="$REPO_ROOT"
	selected=
	;;
*)
	exit 0
	;;
esac

herdr workspace create --cwd "$workspace_cwd" --label "$task_name" --focus >/dev/null
workspace_id=$(
	herdr workspace list |
		jq -r --arg label "$task_name" '.result.workspaces[] | select(.focused == true and .label == $label) | .workspace_id' |
		head -n 1
)
[ -n "$workspace_id" ] || exit 1

initial_tab=$(
	herdr tab list --workspace "$workspace_id" |
		jq -r '.result.tabs[0].tab_id'
)
herdr tab rename "$initial_tab" "$HERDR_AGENT_HARNESS"

pi_pane=$(
	herdr pane list --workspace "$workspace_id" |
		jq -r --arg tab "$initial_tab" '.result.panes[] | select(.tab_id == $tab) | .pane_id' |
		head -n 1
)
herdr pane run "$pi_pane" "$HERDR_AGENT_HARNESS"

printf '%s\n' "$selected" | while IFS= read -r repo_name; do
	[ -n "$repo_name" ] || continue
	repo="$root/$repo_name"

	herdr tab create --workspace "$workspace_id" --cwd "$repo" --label "$repo_name" --no-focus >/dev/null
	repo_tab=$(
		herdr tab list --workspace "$workspace_id" |
			jq -r --arg label "$repo_name" '.result.tabs[] | select(.label == $label) | .tab_id' |
			head -n 1
	)
	nvim_pane=$(
		herdr pane list --workspace "$workspace_id" |
			jq -r --arg tab "$repo_tab" '.result.panes[] | select(.tab_id == $tab) | .pane_id' |
			head -n 1
	)

	herdr pane run "$nvim_pane" nvim
	herdr pane split "$nvim_pane" --direction down --ratio 0.7 --cwd "$repo" --no-focus >/dev/null
done

herdr tab list --workspace "$workspace_id" |
	jq -r '.result.tabs[] | [.number, .tab_id, .label] | @tsv' |
	while IFS="$(printf '\t')" read -r number tab_id label; do
		herdr tab rename "$tab_id" "$number: $label"
	done

herdr tab focus "$initial_tab"
