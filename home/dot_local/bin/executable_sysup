#!/usr/bin/env bash
# sysup — update everything: system packages, dotfiles, and tools.
# Omarchy, plain Arch, and macOS. See README "Maintenance".
#
#   sysup            full run
#   sysup --tools    skip system packages (dotfiles + tools only)
set -euo pipefail

step() { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m%s\033[0m\n' "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }

[ -r "$HOME/.local/sh/dirs.env" ] && . "$HOME/.local/sh/dirs.env"
host_dirs="$HOME/.local/sh/dirs-$(hostname -s).env"
[ -r "$host_dirs" ] && . "$host_dirs"
: "${PI_BIN_DIR:=$HOME/.pi/agent/bin}"
: "${ZOEKT_INDEX_DIR:=$HOME/.zoekt}"
: "${REPO_ROOT:=$HOME/github.com}"
: "${SKILLS_DIRS:=}"
export PATH="$PI_BIN_DIR:$HOME/.local/share/mise/shims:$PATH"

skip_system=false
[ "${1:-}" = "--tools" ] && skip_system=true

# pi-herdr-subagents only reads config.json from its own package dir, which
# `pi update --extensions` recreates (deleting our managed file). Restore it
# instead of treating it as drift.
pi_subagents_cfg="$HOME/.pi/agent/npm/node_modules/pi-herdr-subagents/config.json"
restore_pi_subagents_cfg() {
  if [ -d "${pi_subagents_cfg%/*}" ]; then
    chezmoi apply --force "$pi_subagents_cfg"
  fi
}

# 1. System packages (and mise, which Omarchy's update includes)
if ! $skip_system; then
  if have omarchy; then
    step "Omarchy update (snapshot, system, migrations, AUR, mise)"
    omarchy update
  elif have yay; then
    step "System + AUR packages"
    yay -Syu
    step "mise tools"
    mise up
  elif [ "$(uname)" = Darwin ]; then
    step "Homebrew"
    brew update
    brew upgrade
    step "mise tools"
    mise up
  fi
fi

# 2. Drift gate: stop if anything changed a managed file behind chezmoi's back
#    (first status column = changed since chezmoi last wrote it).
step "Checking dotfiles drift"
restore_pi_subagents_cfg
drift=$(chezmoi status --exclude=scripts | awk 'substr($0, 1, 1) != " "' || true)
if [ -n "$drift" ]; then
  warn "These managed files changed outside chezmoi (Omarchy migration, app, or hand edit):"
  printf '%s\n' "$drift" >&2
  warn "Resolve each one (README \"Drift\"), then re-run: sysup --tools
  chezmoi diff <file>      # see what changed
  chezmoi re-add <file>    # keep the change (plain file), then commit
  chezmoi merge <file>     # keep/blend the change (template), then commit
  chezmoi apply <file>     # discard the change, restore ours"
  exit 1
fi

# 3. Dotfiles: pull + apply (re-runs run_onchange scripts whose inputs changed)
step "Dotfiles (chezmoi update)"
chezmoi update

# 4. Tools
if have herdr; then
  step "herdr + plugins"
  # Self-update only a user-installed herdr; pacman/Homebrew installs are
  # updated in step 1 (herdr update would overwrite a package-owned binary).
  herdr_bin=$(command -v herdr)
  case "$herdr_bin" in
    "$HOME"/*) herdr update --handoff ;;
    *) echo "herdr is package-managed ($herdr_bin); updated with system packages" ;;
  esac
  chezmoi data --format json | jq -r '.herdr.plugins[].repo' | while read -r repo; do
    herdr plugin install "$repo" --yes
  done
fi

if have tmux && [ -x "$HOME/.config/tmux/plugins/tpm/bin/update_plugins" ]; then
  step "tmux plugins"
  # tpm queries a tmux server; use a private one with this config.
  sock="sysup-tpm-$$"
  tmux -L "$sock" -f "$HOME/.config/tmux/tmux.conf" new-session -d -s tpm
  TMUX="$(tmux -L "$sock" display-message -p '#{socket_path}'),0,0" \
    "$HOME/.config/tmux/plugins/tpm/bin/update_plugins" all || warn "tpm update failed"
  tmux -L "$sock" kill-server 2>/dev/null || true
fi

if have nvim; then
  step "Neovim plugins (Lazy)"
  nvim --headless "+Lazy! sync" +qa
fi

if have pi; then
  step "pi models and extensions"
  pi update --models
  pi update --extensions
  restore_pi_subagents_cfg
fi

if have go; then
  step "Zoekt"
  GOBIN="$PI_BIN_DIR" go install \
    github.com/sourcegraph/zoekt/cmd/zoekt@latest \
    github.com/sourcegraph/zoekt/cmd/zoekt-git-index@latest \
    github.com/sourcegraph/zoekt/cmd/zoekt-local-sync@latest
  if [ -d "$REPO_ROOT" ]; then
    zoekt-local-sync -index "$ZOEKT_INDEX_DIR" -f "$REPO_ROOT"
  fi
fi

old_ifs=$IFS
IFS=:
for skills_dir in $SKILLS_DIRS; do
  [ -n "$skills_dir" ] || continue
  if [ -d "$skills_dir/.git" ]; then
    step "Skills: $skills_dir"
    git -C "$skills_dir" pull --ff-only
  fi
done
IFS=$old_ifs

# 5. Validate
if have herdr; then
  step "Validating herdr config"
  herdr config check
  herdr server reload-config >/dev/null 2>&1 || true
fi
if have hyprctl && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
  step "Validating Hyprland config"
  errors=$(hyprctl configerrors)
  [ -z "$errors" ] || [ "$errors" = "no errors" ] || warn "$errors"
fi

step "sysup complete"
