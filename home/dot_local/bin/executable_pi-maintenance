#!/usr/bin/env bash
set -euo pipefail

[ -r "$HOME/.local/sh/dirs.env" ] && . "$HOME/.local/sh/dirs.env"
host_name=$(hostname -s)
host_dirs="$HOME/.local/sh/dirs-$host_name.env"
[ -r "$host_dirs" ] && . "$host_dirs"
: "${PI_BIN_DIR:=$HOME/.pi/agent/bin}"
: "${ZOEKT_INDEX_DIR:=$HOME/.zoekt}"
: "${REPO_ROOT:=$HOME/github.com}"
: "${SKILLS_DIRS:=}"
export PATH="$PI_BIN_DIR:$HOME/.local/share/mise/shims:$PATH"

if command -v brew >/dev/null 2>&1; then
  printf '%s\n' '==> Updating Homebrew'
  brew update
  brew upgrade
fi

printf '%s\n' '==> Updating Herdr'
herdr update --handoff

printf '%s\n' '==> Updating Pi extensions and model catalogs'
pi update --models
pi update --extensions

printf '%s\n' '==> Updating dotfiles (chezmoi)'
chezmoi update

printf '%s\n' '==> Updating Zoekt binaries'
GOBIN="$PI_BIN_DIR" go install \
  github.com/sourcegraph/zoekt/cmd/zoekt@latest \
  github.com/sourcegraph/zoekt/cmd/zoekt-git-index@latest \
  github.com/sourcegraph/zoekt/cmd/zoekt-local-sync@latest

printf '%s\n' '==> Refreshing Zoekt index'
zoekt-local-sync -index "$ZOEKT_INDEX_DIR" -f "$REPO_ROOT"

old_ifs=$IFS
IFS=:
for skills_dir in $SKILLS_DIRS; do
  [ -n "$skills_dir" ] || continue
  if [[ -d "$skills_dir/.git" ]]; then
    printf '==> Updating skills: %s\n' "$skills_dir"
    git -C "$skills_dir" pull --ff-only
  else
    printf '==> Skipping skills: %s is not a Git checkout\n' "$skills_dir"
  fi
done
IFS=$old_ifs

printf '%s\n' '==> Validating and reloading Herdr'
herdr config check
herdr server reload-config

printf '%s\n' 'Maintenance complete.'
