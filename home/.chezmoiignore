# Host-specific files: each host only gets its own <host>.* files.
{{ if ne .chezmoi.hostname "shiva" }}
.local/sh/shiva.*
.local/sh/dirs-shiva.env
.config/tmux/tmux.shiva.conf
{{ end }}
{{ if eq .chezmoi.hostname "ifrit" }}
.ssh/authorized_keys
{{ end }}
{{ if ne .chezmoi.hostname "ifrit" }}
.local/bin/pi
.local/sh/ifrit.*
.local/sh/dirs-ifrit.env
.config/tmux/tmux.ifrit.conf
{{ end }}
{{ if ne .chezmoi.hostname "jarvis" }}
.local/sh/dirs-jarvis.env
{{ end }}

# Neovim: Omarchy's theme integration only on Omarchy; there, theme.lua is a
# symlink owned by omarchy-theme-set, so chezmoi must leave it alone.
{{ if .omarchy }}
.config/nvim/lua/plugins/theme.lua
{{ else }}
.config/nvim/lua/plugins/all-themes.lua
.config/nvim/lua/plugins/omarchy-theme-hotreload.lua
.config/nvim/plugin/after/transparency.lua
{{ end }}

# Hyprland/Omarchy user config only on Omarchy; display scaling is per machine.
{{ if not .omarchy }}
.config/hypr
.config/omarchy
.local/bin/visor
.local/bin/compose-keys
.local/bin/window-switcher
{{ end }}
{{ if ne .chezmoi.hostname "shiva" }}
.config/hypr/monitors.lua
{{ end }}

# macOS-only apps / Linux-only audio
{{ if ne .chezmoi.os "darwin" }}
.config/omniwm
{{ end }}
{{ if eq .chezmoi.os "darwin" }}
.config/pipewire
.config/gammastep
.XCompose
{{ end }}

# GUI-only config on servers (no desktop session)
{{ if not .desktop }}
.config/ghostty
.config/pipewire
.config/gammastep
.XCompose
{{ end }}

# Secret-backed files: skip (leave the existing file untouched) when the
# secrets backend has no session, so everything else still applies.
# List every target whose template uses the "secret" helper here.
{{ if ne .secrets "none" }}
{{   if ne (includeTemplate "secrets-ready" .secrets) "true" }}
{{     warnf "%s is not logged in: skipping secret-backed files (log in, then chezmoi apply)" .secrets }}
.ssh/config.d/private
.local/sh/ifrit.secrets.zshenv
{{   end }}
{{ else }}
.ssh/config.d/private
.local/sh/ifrit.secrets.zshenv
{{ end }}
