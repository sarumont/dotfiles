# Host-specific files: each host only gets its own <host>.* files.
{{ if ne .chezmoi.hostname "shiva" }}
.local/sh/shiva.*
.local/sh/dirs-shiva.env
.config/tmux/tmux.shiva.conf
{{ end }}
{{ if ne .chezmoi.hostname "ifrit" }}
.local/sh/ifrit.*
.local/sh/dirs-ifrit.env
.config/tmux/tmux.ifrit.conf
{{ end }}

# Neovim: Omarchy's theme integration only on Omarchy; there, theme.lua is a
# symlink owned by omarchy-theme-set, so chezmoi must leave it alone.
{{ if .omarchy }}
.config/nvim/lua/plugins/theme.lua
{{ else }}
.config/nvim/lua/plugins/all-themes.lua
.config/nvim/lua/plugins/omarchy-theme-hotreload.lua
.config/nvim/plugin/after/transparency.lua
{{ end }}
