[core]
	excludesfile = ~/gitignore
	autocrlf = input
  pager = less -RFX
[alias]
	ci = commit
	co = checkout
	pr = pull --rebase
	st = status
	up = !git fetch && git rebase --autostash FETCH_HEAD
  dlog = -c diff.external=difft log --ext-diff
  powerwash = !git up && git clean-merged
[column]
  ui = auto
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
	gpgSign = true
[init]
  defaultBranch = main
[difftool]
  prompt = false
[diff]
  external = difft
[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"
[pager]
  difftool = true
[push]
  default = simple
  autoSetupRemote = true
  followTags = true
[fetch]
  prune = true
  pruneTags = true
  all = true
[merge]
  conflictstyle = zdiff3 

[commit]
	gpgSign = true
[gpg]
  format = ssh

[help]
  autocorrect = prompt
[commit]
  verbose = true
[rerere]
  enabled = true
  autoupdate = true
[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true
